{
  "name": "dex-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter='./apps/*' dev",
    "build": "bun run --filter='./apps/*' build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test -c tests/e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
