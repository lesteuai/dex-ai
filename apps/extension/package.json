{
  "name": "@dex-ai/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "dev:chrome": "vite --mode chrome",
    "dev:firefox": "vite --mode firefox"
  },
  "dependencies": {
    "@dex-ai/shared": "workspace:*",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@types/webextension-polyfill": "0.12.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
